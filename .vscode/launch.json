{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Streamlit app1",
      "type": "python",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app/app1.py", "--server.headless=true"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Debug Streamlit app1_updated",
      "type": "python",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app/app1_updated.py", "--server.headless=true"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  ]
}
